# Ghostty Terminal Configuration

# Theme
theme = tokyonight

# Font - google sans code has no glyph icons, so fall back to a nerd font for them
font-family = "Google Sans Code"
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13

# Window
window-padding-x = 10
window-padding-y = 10

# Cursor
cursor-style = block

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title
